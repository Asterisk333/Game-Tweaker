Windows Registry Editor Version 5.00

; ============================================================
; MOUSE
; Disable Windows mouse acceleration / Enhance Pointer Precision
; ============================================================

[HKEY_CURRENT_USER\Control Panel\Mouse]
"MouseSpeed"="0"
"MouseThreshold1"="0"
"MouseThreshold2"="0"


; ============================================================
; KEYBOARD
; Fastest standard keyboard repeat configuration
; KeyboardDelay: 0 = shortest delay
; KeyboardSpeed: 31 = fastest repeat rate
; ============================================================

[HKEY_CURRENT_USER\Control Panel\Keyboard]
"KeyboardDelay"="0"
"KeyboardSpeed"="31"


; ============================================================
; GAME DVR / BACKGROUND RECORDING
; Disable background capture for the current user
; ============================================================

[HKEY_CURRENT_USER\System\GameConfigStore]
"GameDVR_Enabled"=dword:00000000

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\GameDVR]
"AppCaptureEnabled"=dword:00000000


; ============================================================
; POWER THROTTLING
; Prevent Windows from throttling background processes globally
; ============================================================

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Power\PowerThrottling]
"PowerThrottlingOff"=dword:00000001